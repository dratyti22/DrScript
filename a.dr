for (i = 1; i <= 10; i++) {
    print(3 * i);  // таблица умножения на 3
}

// Вложенные циклы
for (i = 1; i <= 3; i++) {
    for (j = 1; j <= 3; j++) {
        print(i * j);
    }
}

fun add(n) {
    if n <= 1 {
        return 1;
    } else {
        return n * add(n-1);
    }
}
